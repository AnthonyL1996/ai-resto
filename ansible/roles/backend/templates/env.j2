# AI Resto Backend Configuration
# Generated by Ansible - Do not edit manually

# Database
DATABASE_URL=postgresql://{{ db_user }}:{{ db_password }}@{{ db_host }}:{{ db_port }}/{{ db_name }}
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Security
SECRET_KEY={{ secret_key }}
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis
REDIS_URL=redis://{{ redis_host }}:{{ redis_port }}/{{ redis_db }}

# Email
SMTP_SERVER={{ smtp_server | default('') }}
SMTP_PORT={{ smtp_port | default('587') }}
SMTP_USER={{ smtp_user | default('') }}
SMTP_PASSWORD={{ smtp_password | default('') }}
SENDER_EMAIL={{ sender_email }}

# Payment
PAYCONIQ_API_KEY={{ payconiq_api_key | default('') }}
PAYCONIQ_API_URL={{ payconiq_api_url | default('https://api.payconiq.com/v3/payments') }}
PAYCONIQ_WEBHOOK_SECRET={{ payconiq_webhook_secret | default('') }}
BASE_URL=https://{{ domain_name }}

# Application
DEBUG={{ 'True' if deployment_environment != 'production' else 'False' }}
LOG_LEVEL={{ log_level | default('INFO') }}
ENVIRONMENT={{ deployment_environment }}

# CORS
ALLOWED_ORIGINS={{ cors_allowed_origins | join(',') }}

# Rate Limiting
RATE_LIMIT_ENABLED={{ 'True' if rate_limit_enabled else 'False' }}
RATE_LIMIT_PER_MINUTE={{ rate_limit_per_minute | default(60) }}
