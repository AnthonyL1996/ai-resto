# Ansible-specific gitignore

# Ansible retry files
*.retry

# Vault password files
.vault_pass
.vault_password
*vault_pass*
*vault_password*

# Encrypted vault files (optional - you may want to commit encrypted vaults)
# group_vars/*/vault.yml
# host_vars/*/vault.yml

# Temporary files
*.tmp
*.swp
*.swo
*~

# Python
__pycache__/
*.py[cod]
*.pyo

# Logs
*.log

# IDE
.vscode/
.idea/
*.iml

# OS
.DS_Store
Thumbs.db

# Backup files
*.bak
*.backup
